---
import ProjectList from "@/components/project-list.astro";
import type { Project } from "@/lib/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="expandable-projects" data-expandable-projects>
  <div id="about-project-list" data-project-content>
    <ProjectList projects={projects} />
  </div>
  <div aria-hidden="true" class="projects-fade" data-project-fade hidden></div>
  <button
    aria-controls="about-project-list"
    aria-expanded="false"
    class="projects-show-more"
    data-project-expand
    hidden
    type="button"
  >Show more</button>
</div>

<style>
  .expandable-projects {
    position: relative;
    display: flow-root;
  }

  .expandable-projects[data-collapsed],
  .expandable-projects[data-expanding] {
    overflow: hidden;
  }

  .projects-fade {
    position: absolute;
    inset: var(--projects-fade-start) 0 0;
    background: linear-gradient(to bottom, transparent, var(--background) 70%);
    pointer-events: none;
  }

  .projects-show-more {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 9999px;
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: nowrap;
    transition: background-color 140ms ease, transform 140ms var(--motion-ease);
  }

  .projects-show-more:focus-visible {
    outline-offset: -4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .projects-show-more:hover {
      background: var(--nav-hover);
    }
  }

  .projects-show-more:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-show-more {
      transition: none;
    }

    .projects-show-more:active {
      transform: none;
    }
  }
</style>

<script>
  import { initExpandableProjects } from "@/lib/expandable-projects";

  initExpandableProjects();
</script>
