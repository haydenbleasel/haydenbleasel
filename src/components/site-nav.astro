---
import { pagePath } from "@/lib/page-path";
import { isPostPath } from "@/lib/posts";

const links = [
  { href: "/about", label: "About" },
  { href: "/writing", label: "Writing" },
  { href: "/speaking", label: "Speaking" },
  { href: "/press", label: "Press" },
];
const pathname = pagePath(Astro.url.pathname);
// Pages under a link's section mark it as the current location. Every post
// belongs to Writing, including those postPath serves from the root.
const isWithin = (href: string) =>
  pathname.startsWith(`${href}/`) ||
  (href === "/writing" && isPostPath(pathname));
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  {pathname === "/" ? <h1 class="site-name">Hayden Bleasel</h1> : <a class="site-name" href="/">Hayden Bleasel</a>}
  <nav aria-label="Main navigation" class="site-nav">
    <span aria-hidden="true" class="site-nav-hover" />
    {links.map((link) => (
      <a href={link.href} aria-current={pathname === link.href ? "page" : isWithin(link.href) ? "location" : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initNavHover } from "@/lib/nav-hover";

  initNavHover();
</script>
