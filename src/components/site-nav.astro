---
import { pagePath } from "@/lib/page-path";
import { isPostPath } from "@/lib/posts";

interface NavLink {
  href: string;
  label: string;
  // Whether a page belongs to the link's section, which marks the link as the
  // current location. Defaults to pages under its path.
  within?: (pathname: string) => boolean;
}

const links: NavLink[] = [
  { href: "/about", label: "About" },
  // Every post, including those postPath serves from the root.
  { href: "/writing", label: "Writing", within: isPostPath },
  { href: "/speaking", label: "Speaking" },
  { href: "/press", label: "Press" },
];
const pathname = pagePath(Astro.url.pathname);
const isWithin = ({ href, within }: NavLink) =>
  within ? within(pathname) : pathname.startsWith(`${href}/`);
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  {pathname === "/" ? <h1 class="site-name">Hayden Bleasel</h1> : <a class="site-name" href="/">Hayden Bleasel</a>}
  <nav aria-label="Main navigation" class="site-nav">
    <span aria-hidden="true" class="site-nav-hover" />
    {links.map((link) => (
      <a href={link.href} aria-current={pathname === link.href ? "page" : isWithin(link) ? "location" : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initNavHover } from "@/lib/nav-hover";

  initNavHover();
</script>
