{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3010",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "types": "astro check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "bump-deps": "npx npm-check-updates -u && bun i",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/markdown-satteri": "0.4.0",
    "astro": "^7.2.0",
    "satteri": "0.10.5",
    "takumi-js": "^2.9.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.13",
    "@types/node": "^25",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "ultracite": "^7.8.3",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "vscode-languageserver-protocol": "3.17.5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "sharp"
  ]
}
