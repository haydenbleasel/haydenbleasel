---
import Page from "@/layouts/page.astro";
import { identity, person, personRef } from "@/lib/person";
import { press } from "@/lib/press";

export const prerender = true;

const title = "Press";
const description =
  "A factual index of independent press coverage of me and my work.";

const jsonLd = {
  "@context": "https://schema.org",
  "@id": `${identity}/press#webpage`,
  "@type": "CollectionPage",
  about: person,
  description,
  mainEntity: {
    "@type": "ItemList",
    // Only articles that actually name me assert Article.about — company
    // milestone coverage stays a plain ListItem so the claim is accurate.
    itemListElement: press.map((item, index) =>
      item.mentionsMe
        ? {
            "@type": "ListItem",
            item: {
              // VideoObject uses `name`; Article uses `headline`.
              ...(item.type === "video"
                ? { "@type": "VideoObject", name: item.title }
                : { "@type": "Article", headline: item.title }),
              about: personRef,
              publisher: { "@type": "Organization", name: item.outlet },
              url: item.url,
            },
            position: index + 1,
          }
        : {
            "@type": "ListItem",
            name: item.title,
            position: index + 1,
            url: item.url,
          }
    ),
  },
  name: "Press coverage of Hayden Bleasel",
  url: `${identity}/press`,
};
---

<Page description={description} jsonLd={jsonLd} title={title}>
  <div class="grid gap-8">
    {
      press.map((item) => (
        <a
          class="group grid gap-1"
          href={item.url}
          rel="noopener noreferrer"
          target="_blank"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-medium leading-relaxed transition-colors duration-300 group-hover:text-zinc-500">
              {item.title}
            </h2>
            <span class="shrink-0 text-sm text-zinc-500 tabular-nums">
              {item.year}
            </span>
          </div>
          <p class="text-sm text-zinc-600 leading-relaxed transition-colors duration-300 dark:text-zinc-400">
            {item.note}
          </p>
          <p class="text-sm text-zinc-500">{item.outlet}</p>
        </a>
      ))
    }
  </div>
</Page>
