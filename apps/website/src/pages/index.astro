---
import Layout from "@/layouts/layout.astro";
import Lifeline from "@/components/lifeline/lifeline.astro";
import NewsletterInline from "@/components/newsletter-inline.astro";
import ThemeSwitcher from "@/components/theme-switcher.astro";
import { haydenLifeline } from "@/lib/hayden";

export const prerender = true;

const CONTAINER = "mx-auto flex w-full max-w-5xl items-center px-6";
---

<Layout>
  <div
    class="flex h-dvh flex-col overflow-hidden bg-white text-black antialiased transition-colors duration-300 dark:bg-black dark:text-white"
  >
    <nav
      class="fixed inset-x-0 top-0 z-50 bg-white/80 backdrop-blur-xl transition-colors duration-300 dark:bg-black/80"
    >
      <div class:list={[CONTAINER, "h-12 justify-between"]} data-site-nav-inner>
        <a
          aria-label="Hayden Bleasel — Home"
          class="whitespace-nowrap font-medium text-black text-sm transition-[color,opacity] duration-300 hover:opacity-70 dark:text-white"
          data-site-nav-logo
          href="/"
        >
          Hayden Bleasel
        </a>

        <div class="flex items-center gap-8">
          <a
            aria-label="GitHub"
            class="text-zinc-500 transition-colors duration-300 hover:text-black dark:hover:text-white"
            href="https://github.com/haydenbleasel"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              aria-hidden="true"
              class="size-4"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
          <a
            class="text-sm text-zinc-500 transition-colors duration-300 hover:text-black dark:hover:text-white"
            href="https://x.com/haydenbleasel"
            rel="noopener noreferrer"
            target="_blank"
          >
            𝕏
          </a>
        </div>
      </div>
    </nav>

    {/* pt-16 clears the fixed nav; md hands scrolling to the scrub. */}
    <main class="min-h-0 flex-1 overflow-y-auto pt-12 md:overflow-hidden">
      <Lifeline
        birthYear={haydenLifeline.birthYear}
        markers={haydenLifeline.markers}
        title={haydenLifeline.name}
      />
    </main>

    <footer
      class="shrink-0 bg-white/95 backdrop-blur-sm transition-colors duration-300 dark:bg-black/95"
    >
      <div class:list={[CONTAINER, "h-12 justify-between gap-6"]}>
        <ThemeSwitcher />

        <div class="flex items-center gap-3">
          <NewsletterInline />
        </div>
      </div>
    </footer>
  </div>
</Layout>
