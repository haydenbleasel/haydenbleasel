---
import Layout from "@/layouts/layout.astro";
import Lifeline from "@/components/lifeline/lifeline.astro";
import NewsletterInline from "@/components/newsletter-inline.astro";
import SiteNav from "@/components/site-nav.astro";
import SocialLinks from "@/components/social-links.astro";
import ThemeSwitcher from "@/components/theme-switcher.astro";
import { haydenLifeline } from "@/lib/hayden";

export const prerender = true;

const CONTAINER = "mx-auto flex w-full max-w-5xl items-center px-6";
---

<Layout>
  <div
    class="flex h-dvh flex-col overflow-hidden bg-white text-black antialiased transition-colors duration-300 dark:bg-black dark:text-white"
  >
    <SiteNav />

    {/* pt-16 clears the fixed nav; md hands scrolling to the scrub. */}
    <main class="min-h-0 flex-1 overflow-y-auto pt-12 md:overflow-hidden">
      <Lifeline
        birthYear={haydenLifeline.birthYear}
        markers={haydenLifeline.markers}
        title={haydenLifeline.name}
      />
    </main>

    <footer
      class="shrink-0 bg-[rgba(255,255,255,0.95)] backdrop-blur-sm transition-colors duration-300 dark:bg-[rgba(0,0,0,0.95)]"
    >
      <div class:list={[CONTAINER, "h-12 justify-between gap-6"]}>
        <div class="flex items-center gap-4">
          <ThemeSwitcher />

          <div
            aria-hidden="true"
            class="h-4 w-px bg-zinc-200 transition-colors duration-300 dark:bg-zinc-800"
          >
          </div>

          <SocialLinks />
        </div>

        <div class="flex items-center gap-3">
          <NewsletterInline />
        </div>
      </div>
    </footer>
  </div>
</Layout>
